# Every deployed machine downloads this source-free release repository. Put
# the private key value only in ansible-vault as
# vault_video_mask_release_deploy_key; never commit it in this file.
video_mask_release_repo: git@github.com:ryvengray/video-mask-release.git
video_mask_release_ref: main
video_mask_release_dir: /home/ubuntu/video-mask-release
video_mask_release_deploy_key_path: /home/ubuntu/.ssh/video-mask-release
video_mask_release_version: CHANGE_ME_TO_A_PUBLISHED_RELEASE_VERSION
video_mask_release_install_root: /opt/video-mask/releases
video_mask_release_deploy_key: "{{ vault_video_mask_release_deploy_key }}"
# Use the Controller private VPC address for remote Workers. No HTTPS is
# required on the private network; restrict TCP 8080 to the Worker security group.
video_mask_controller_url: http://10.0.0.10:8080
# Store these secrets with ansible-vault, never commit real values.
video_mask_admin_token: CHANGE_ME_TO_A_LONG_RANDOM_SECRET
video_mask_worker_token: CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Testing mode: controller and Worker use their local /home/ubuntu directories.
# Change to s3 after the external source Bucket grants cross-account read access.
video_mask_storage_mode: local
video_mask_local_source_dir: /home/ubuntu/cluster_test_sources
video_mask_local_output_dir: /home/ubuntu/cluster_test_outputs
# Reserved S3 settings. Leave blank until the external Bucket owner supplies them.
video_mask_s3_source_bucket: ''
video_mask_s3_source_prefix: source/inbox/
video_mask_s3_source_region: ''
video_mask_s3_assume_role_arn: ''
video_mask_s3_output_bucket: ''
video_mask_s3_output_prefix: outputs/
video_mask_s3_output_region: ''
