[Unit]
Description=Video Mask Cluster Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/etc/video-mask-worker.env
Environment=VIDEO_MASK_RUNTIME_PYTHON={{ video_mask_runtime_venv | default('/opt/video-mask/runtime-venv') }}/bin/python
Environment=PYTHONPATH={{ video_mask_release_install_root | default('/opt/video-mask/releases') }}/{{ video_mask_release_version }}/python
WorkingDirectory={{ video_mask_release_install_root | default('/opt/video-mask/releases') }}/{{ video_mask_release_version }}
ExecStart={{ video_mask_release_install_root | default('/opt/video-mask/releases') }}/{{ video_mask_release_version }}/bin/video-mask-worker --controller ${VIDEO_MASK_CONTROLLER} --worker-id ${VIDEO_MASK_WORKER_ID} --token ${VIDEO_MASK_WORKER_TOKEN} --work-dir /home/ubuntu/work/video-mask --algorithm {{ video_mask_release_install_root | default('/opt/video-mask/releases') }}/{{ video_mask_release_version }}/bin/video-mask-batch-fish{{ ' --allow-local-files' if video_mask_storage_mode | default('local') == 'local' else '' }}
Restart=always
RestartSec=10
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
