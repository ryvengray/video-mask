[Unit]
Description=Video Mask Cluster Worker Slot %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/etc/video-mask-worker@%i.env
WorkingDirectory={{ video_mask_app_dir }}
StandardOutput=append:/var/log/video-mask-worker/slot-%i.log
StandardError=inherit
ExecStart={{ video_mask_app_dir }}/.venv/bin/python -m cluster.worker_agent --controller ${VIDEO_MASK_CONTROLLER} --worker-id ${VIDEO_MASK_WORKER_ID} --token ${VIDEO_MASK_WORKER_TOKEN} --work-dir /home/ubuntu/work/video-mask/%i --completed-output-dir /home/ubuntu/outputs --algorithm {{ video_mask_app_dir }}/video_mask_batch_fish_v1.py{{ ' --allow-local-files' if video_mask_storage_mode | default('local') == 'local' else '' }}
Restart=always
RestartSec=10
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
