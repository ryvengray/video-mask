[Unit]
Description=Video Mask EC2 Worker Autoscaler
After=network-online.target video-mask-controller.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/etc/video-mask-controller.env
WorkingDirectory={{ video_mask_app_dir }}
ExecStart={{ video_mask_app_dir }}/.venv/bin/python -m cluster.autoscaler --controller-url {{ video_mask_autoscale_controller_url | default('http://127.0.0.1:8080') }} --pool-file {{ video_mask_autoscale_pool_file | default('/opt/dataai-ec2/data/ec2_host_pool.yaml') }} --pool-refresh-command {{ video_mask_autoscale_pool_refresh_command | default('/opt/dataai-ec2/bin/ec2_pool.sh') }} --pool-refresh-timeout-seconds {{ video_mask_autoscale_pool_refresh_timeout_seconds | default(120) }} --start-command {{ video_mask_autoscale_start_command | default('/opt/dataai-ec2/bin/start_ec2.sh') }} --stop-command {{ video_mask_autoscale_stop_command | default('/opt/dataai-ec2/bin/stop_ec2.sh') }}{% for host_ip, slots in (video_mask_autoscale_host_slots | default({}) | dictsort) %} --host-slot {{ host_ip }}={{ slots }}{% endfor %} --state-file /var/lib/video-mask-autoscaler/state.json --event-log {{ video_mask_autoscale_event_log | default('/var/log/video-mask-autoscaler/events.log') }} --check-seconds {{ video_mask_autoscale_check_seconds | default(60) }} --idle-shutdown-seconds {{ video_mask_autoscale_idle_shutdown_seconds | default(1800) }} --min-running-hosts {{ video_mask_autoscale_min_running_hosts | default(0) }} --max-start-per-check {{ video_mask_autoscale_max_start_per_check | default(1) }} --max-stop-per-check {{ video_mask_autoscale_max_stop_per_check | default(1) }} --start-grace-seconds {{ video_mask_autoscale_start_grace_seconds | default(900) }} --stop-grace-seconds {{ video_mask_autoscale_stop_grace_seconds | default(1800) }} --command-timeout-seconds {{ video_mask_autoscale_command_timeout_seconds | default(900) }} --pending-grace-seconds {{ video_mask_autoscale_pending_grace_seconds | default(60) }}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
