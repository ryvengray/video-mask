[Unit]
Description=Video Mask Cluster Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/etc/video-mask-controller.env
WorkingDirectory={{ video_mask_app_dir }}
ExecStart={{ video_mask_app_dir }}/.venv/bin/python -m cluster.controller --database /var/lib/video-mask-controller/controller.sqlite3 --host 0.0.0.0 --port 8080{{ ' --local-source-dir ' ~ video_mask_local_source_dir ~ ' --local-output-dir ' ~ video_mask_local_output_dir if video_mask_storage_mode | default('local') == 'local' else '' }}{{ ' --s3-source-bucket ' ~ video_mask_s3_source_bucket ~ ' --s3-source-prefix ' ~ video_mask_s3_source_prefix ~ ' --s3-output-bucket ' ~ video_mask_s3_output_bucket ~ ' --s3-output-prefix ' ~ video_mask_s3_output_prefix ~ ' --s3-region ' ~ video_mask_s3_source_region ~ ' --s3-profile ' ~ video_mask_s3_profile ~ ' --s3-poll-seconds ' ~ video_mask_s3_poll_seconds ~ ' --s3-presign-seconds ' ~ video_mask_s3_presign_seconds if video_mask_storage_mode | default('local') == 's3' else '' }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
