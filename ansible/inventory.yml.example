controller:
  hosts:
    controller-01:
      ansible_host: 10.0.0.10

gpu_workers:
  vars:
    ansible_user: ubuntu
    # Path on the machine running Ansible.  Use an absolute path to the
    # Terraform-created SSH private key when adding a remote Worker.
    # ansible_ssh_private_key_file: /absolute/path/to/terraform-host.pem
    # Password SSH option: keep actual values only in group_vars/all/vault.yml.
    # ansible_password: "{{ vault_video_mask_worker_ssh_password }}"
    # ansible_become_password: "{{ vault_video_mask_worker_sudo_password }}"
    # Dynamic Worker option: safely accept a host key only on its first connection.
    # ansible_ssh_common_args: "-o StrictHostKeyChecking=accept-new"
  hosts:
    worker-01:
      ansible_host: 43.166.162.143
      video_mask_worker_id: worker-01
      # Override the global default for this physical Worker if needed.
      video_mask_worker_slots: 2
