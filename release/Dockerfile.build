# syntax=docker/dockerfile:1.7
# Build Cython-native proprietary modules on Ubuntu 24.04 x86_64.
FROM --platform=linux/amd64 ubuntu:24.04

ARG UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN sed -i \
      -e "s|http://archive.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
      -e "s|http://security.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
      /etc/apt/sources.list.d/ubuntu.sources && \
    for attempt in 1 2 3 4 5; do \
      apt-get -o Acquire::Retries=5 update; \
      apt-get -o Acquire::Retries=5 -y --fix-broken install || true; \
      if apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        build-essential python3 python3-dev python3-pip python3-venv ca-certificates; then break; fi; \
      test "$attempt" = 5 && exit 1; sleep 10; \
    done && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build/video-mask
COPY . .

RUN python3 -m venv /opt/build-venv && \
    /opt/build-venv/bin/python -m pip install --upgrade pip setuptools wheel Cython

RUN mkdir -p /opt/release/python/cluster /opt/release/bin && \
    /opt/build-venv/bin/python release/build_cython.py build_ext \
      --build-lib /opt/release/python --build-temp /tmp/video-mask-cython-build && \
    : > /opt/release/python/cluster/__init__.py && \
    cp release/wrappers/video-mask-* /opt/release/bin/ && \
    cp release/requirements-controller.txt release/requirements-worker.txt /opt/release/ && \
    chmod 0755 /opt/release/bin/video-mask-*
