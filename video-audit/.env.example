# Controller 地址
# 如果 Controller 在本地，使用 host.docker.internal
# 如果 Controller 在远程服务器，填写完整地址
CONTROLLER_URL=http://host.docker.internal:8000

# Controller Admin Token（用于 /api/tasks 等管理接口，play 接口不需要）
CONTROLLER_TOKEN=

# Nginx 基本认证（如果 Controller 前面有 Nginx auth_basic）
# 格式: username:password
CONTROLLER_AUTH_USER=
CONTROLLER_AUTH_PASS=
