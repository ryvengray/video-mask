# Controller 地址
# 如果 Controller 在本地，使用 host.docker.internal
# 如果 Controller 在远程服务器，填写完整地址
CONTROLLER_URL=http://host.docker.internal:8000

# Controller Admin Token（用于 /api/tasks 等管理接口，填写原始 Token 即可，
# 服务会自动添加 Bearer 前缀；也可填写完整的 "Bearer <Token>"）
CONTROLLER_TOKEN=

# Nginx 基本认证（如果 Controller 前面有 Nginx auth_basic）
# 需同时填写用户名和密码；Controller 的 Nginx 配置会将 Bearer Token
# 从 X-Video-Mask-Authorization 转发给上游，避免与 Basic Auth 冲突。
CONTROLLER_AUTH_USER=
CONTROLLER_AUTH_PASS=
